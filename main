=== FILE: components/ToolCard.jsx ===
import React from 'react'
import clsx from 'clsx'

export default function ToolCard({tool}){
  return (
    <article className="bg-white rounded-2xl shadow-sm p-4 flex flex-col gap-3" role="article" aria-labelledby={`title-${tool.id}`}>
      <header>
        <h3 id={`title-${tool.id}`} className="font-semibold text-lg">{tool.title}</h3>
        <p className="text-sm text-gray-500">{tool.subtitle}</p>
      </header>

      <div className="flex gap-3 items-start sm:items-center flex-col sm:flex-row">
        <figure className="w-full sm:w-1/3 bg-gray-50 rounded overflow-hidden border border-gray-100">
          <img src={tool.exampleInput} alt={`${tool.title} input`} className="w-full h-36 object-cover"/>
          <figcaption className="p-2 text-xs text-gray-400">Input</figcaption>
        </figure>
        <figure className="w-full sm:w-1/3 bg-gray-50 rounded overflow-hidden border border-gray-100">
          <img src={tool.exampleOutput} alt={`${tool.title} output`} className="w-full h-36 object-cover"/>
          <figcaption className="p-2 text-xs text-gray-400">Output (example)</figcaption>
        </figure>

        <div className="flex-1 w-full">
          <label htmlFor={`prompt-${tool.id}`} className="sr-only">Prompt template</label>
          <textarea id={`prompt-${tool.id}`} defaultValue={tool.template} rows={8} className="w-full p-3 rounded-lg border border-gray-200 bg-gray-50 text-sm resize-none" aria-describedby={`help-${tool.id}`}></textarea>
          <div className="mt-2 flex items-center gap-3">
            <button className="inline-flex items-center gap-2 px-3 py-2 bg-action text-white rounded-md shadow-sm" onClick={async (e)=>{
              const el = document.getElementById(`prompt-${tool.id}`)
              await navigator.clipboard.writeText(el.value)
              // minimal accessible feedback
              const status = document.getElementById(`status-${tool.id}`)
              status.textContent = 'Prompt copied to clipboard'
              setTimeout(()=>status.textContent='',1600)
            }} aria-label={`Copy prompt for ${tool.title}`}>Copy prompt</button>
            <button className="px-3 py-2 border rounded-md text-sm" onClick={()=>{
              const el = document.getElementById(`prompt-${tool.id}`)
              // reset to template
              el.value = tool.template
            }}>Reset</button>
            <span id={`status-${tool.id}`} className="text-sm text-green-600" aria-live="polite"></span>
          </div>
        </div>
      </div>

    </article>
  )
}

=== FILE: components/Dashboard.jsx ===
import React from 'react'
import ToolCard from './ToolCard'
import { TOOLS } from '../lib/tools'

export default function Dashboard(){
  return (
    <main className="container">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold">Banana Split AI</h1>
          <p className="text-gray-500">Nano banana prompt generator — pick a micro-tool and copy the Gemini-style prompt.</p>
        </div>
        <nav aria-label="Primary">
          <a className="text-sm px-3 py-2 rounded-md border" href="#">Docs</a>
        </nav>
      </div>

      <section className="grid gap-5 grid-cols-1 sm:grid-cols-2">
        {TOOLS.map((t)=> <ToolCard key={t.id} tool={t} />)}
      </section>

      <footer className="mt-8 text-sm text-gray-400">Prompts are structured in accordance with the Gemini image-generation guidance.</footer>
    </main>
  )
}

